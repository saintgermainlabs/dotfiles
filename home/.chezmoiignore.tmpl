# Chezmoi source metadata — never apply to $HOME.
/.chezmoi.toml.tmpl
/.chezmoidata/
/.chezmoiignore.tmpl
/.chezmoitemplates/
/configs/
/configs/dconf/

# Secrets: live-only (~/.config/secrets/.env), never managed or added by chezmoi.
.config/secrets/
**/.env

# Placeholders
.gitkeep

# macOS / editor noise
.DS_Store

# --- Host Specific
{{ if eq .role "remote" }}

.config/some-desktop-app/
{{ end }}



# --- Module gates (dig so missing data during init does not explode) ---

{{- if not (dig "git" false .modules) }}
.gitconfig
{{- end }}

{{- if not (dig "ssh" false .modules) }}
.ssh/config
{{- end }}

# Never overwrite the hand-written / omakub base mise config.
.config/mise/config.toml

{{- if not (dig "mise" false .modules) }}
.config/mise/conf.d/
{{- end }}

{{- if not (dig "docker" false .modules) }}
.dotfiles/modules/docker/
{{- end }}

{{- if not (dig "hashicorp-vault" false .modules) }}
.dotfiles/modules/hashicorp-vault/
{{- end }}

{{- if not (dig "openclaw" false .modules) }}
.dotfiles/modules/openclaw/
{{- end }}

{{- if not (dig "hermes" false .modules) }}
.dotfiles/modules/hermes/
{{- end }}

{{- if not (dig "hermes-v2" false .modules) }}
.dotfiles/modules/hermes-v2/
{{- end }}

{{- if not (dig "coolify-manager" false .modules) }}
.dotfiles/modules/coolify-manager/
{{- end }}

{{- if not (dig "common" false .modules) }}
.dotfiles/common/*
# helpers.sh (_df_source, _df_load_module) is needed even without common.
!.dotfiles/common/helpers.sh
{{- end }}

# --- Headless / remote: drop every desktop path when gui = false ---
# Unknown hosts default to gui=false; Nautilus scripts live under .local/share/nautilus/.
{{- if not (dig "gui" false .) }}
.config/mimeapps.list
.config/nautilus/
.local/share/nautilus/
.local/share/nautilus-python/
.config/dotfiles/nautilus-extensions.toml
.config/thunar/
.config/alacritty/
.config/ulauncher/
.config/environment.d/
.cursor/
.gemini/
.local/bin/organize_downloads
.local/bin/stash_clipboard_url
.local/share/applications/Alacritty.desktop
.local/share/applications/alacritty-remote.desktop
.local/share/applications/alacritty-agent.desktop
.local/share/icons/hicolor/256x256/apps/alacritty-*.png
{{- else }}
# GUI host: still respect per-module toggles
{{- if not (dig "gui" false .modules) }}
.config/mimeapps.list
{{- end }}

{{- if not (dig "nautilus" false .modules) }}
.config/nautilus/
.local/share/nautilus/
{{- end }}

{{- if not (dig "nautilus_extensions" false .modules) }}
.config/dotfiles/nautilus-extensions.toml
.local/share/nautilus-python/
{{- end }}

{{- if not (dig "thunar" false .modules) }}
.config/thunar/
{{- end }}
{{- end }}

# Role extras: only apply the matching role directory.
{{- if ne (dig "role" "remote" .) "local" }}
.dotfiles/local/
.local/bin/openclaw-remote
.dotfiles/modules/hermes-v2/
.dotfiles/modules/local_to_remote/
{{- end }}
{{- if ne (dig "role" "remote" .) "remote" }}
.dotfiles/remote/
{{- end }}
{{- if not (dig "local_to_remote" false .modules) }}
.dotfiles/modules/local_to_remote/
{{- end }}

server_only/

# Python bytecode caches (e.g. nemo-python extensions)
**/__pycache__

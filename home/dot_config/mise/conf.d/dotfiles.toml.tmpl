{{- if .modules.mise -}}
# Managed by chezmoi — additive mise config.
# Does NOT replace ~/.config/mise/config.toml (hand-written / omakub base).
# mise merges this file from conf.d with your base config.toml.

[tools]
ripgrep = "latest"
fzf = "latest"
fd = "latest"
bat = "latest"
eza = "latest"
zoxide = "latest"
{{- if eq .role "local" }}
lazygit = "latest"
lazydocker = "latest"
starship = "latest"
{{- end }}
{{- if index .modules "hashicorp-vault" }}
vault = "latest"
jq = "latest"
{{- end }}
[env]
# Secrets (not in git): see ~/.dotfiles/secrets.env.example. Missing file is ignored.
_.file = { path = "{{ .chezmoi.homeDir }}/.config/secrets/.env", redact = true }
UNIVERSAL_AGENT_WORKSPACE="/home/god/Agents/universal-agent-workspace"
{{- if eq .role "local" }}
HERMES_DESKTOP_REMOTE_URL = "https://hermes.tiger-bushmaster.ts.net"

{{- end }}
{{- end -}}


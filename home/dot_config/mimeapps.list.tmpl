{{- if and .gui .modules.gui -}}
# Managed by chezmoi (gui module).
# Sublime Text handles text, source code, configuration and markup files.
# SQLite databases are opened with DBeaver.

[Default Applications]

# Plain text and documentation
text/plain=sublime_text.desktop;
text/markdown=sublime_text.desktop;
text/x-markdown=sublime_text.desktop;
text/csv=sublime_text.desktop;
text/tab-separated-values=sublime_text.desktop;

# Structured data and configuration
application/json=sublime_text.desktop;
application/ld+json=sublime_text.desktop;
application/xml=sublime_text.desktop;
text/xml=sublime_text.desktop;
application/x-yaml=sublime_text.desktop;
text/yaml=sublime_text.desktop;
text/x-yaml=sublime_text.desktop;
application/toml=sublime_text.desktop;
text/x-toml=sublime_text.desktop;
text/x-properties=sublime_text.desktop;
application/x-ini=sublime_text.desktop;

# Shell and scripting languages
application/x-shellscript=sublime_text.desktop;
text/x-shellscript=sublime_text.desktop;
text/x-python=sublime_text.desktop;
application/x-python=sublime_text.desktop;
application/x-ruby=sublime_text.desktop;
text/x-perl=sublime_text.desktop;
text/x-php=sublime_text.desktop;
text/x-lua=sublime_text.desktop;

# Web development
text/html=sublime_text.desktop;
text/css=sublime_text.desktop;
application/javascript=sublime_text.desktop;
text/javascript=sublime_text.desktop;
application/x-javascript=sublime_text.desktop;
application/typescript=sublime_text.desktop;
text/typescript=sublime_text.desktop;
text/jsx=sublime_text.desktop;
text/tsx=sublime_text.desktop;
application/graphql=sublime_text.desktop;

# Programming languages
text/x-c=sublime_text.desktop;
text/x-csrc=sublime_text.desktop;
text/x-chdr=sublime_text.desktop;
text/x-c++src=sublime_text.desktop;
text/x-c++hdr=sublime_text.desktop;
text/x-java=sublime_text.desktop;
text/x-csharp=sublime_text.desktop;
text/x-go=sublime_text.desktop;
text/x-rust=sublime_text.desktop;
text/x-kotlin=sublime_text.desktop;
text/x-scala=sublime_text.desktop;
text/x-swift=sublime_text.desktop;

# Build files, SQL, logs and patches
text/x-makefile=sublime_text.desktop;
text/x-cmake=sublime_text.desktop;
text/x-sql=sublime_text.desktop;
application/sql=sublime_text.desktop;
text/x-log=sublime_text.desktop;
text/x-diff=sublime_text.desktop;
text/x-patch=sublime_text.desktop;

# SQLite databases
application/vnd.sqlite3=dbeaver.desktop;
application/x-sqlite3=dbeaver.desktop;
application/x-sqlite2=dbeaver.desktop;

# Directory handling
{{- if .modules.thunar }}
inode/directory=thunar.desktop;
{{- else }}
inode/directory=org.gnome.Nautilus.desktop;
{{- end }}

[Added Associations]
text/plain=sublime_text.desktop;
text/markdown=sublime_text.desktop;
application/json=sublime_text.desktop;
application/x-yaml=sublime_text.desktop;
application/x-shellscript=sublime_text.desktop;
application/vnd.sqlite3=dbeaver.desktop;
application/x-sqlite3=dbeaver.desktop;

{{- end -}}

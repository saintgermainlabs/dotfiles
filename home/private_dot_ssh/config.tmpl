{{- if .modules.ssh -}}
# DevPod Start openclaw-portal.devpod
Host openclaw-portal.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/usr/local/bin/devpod" ssh --stdio --context default --user node openclaw-portal --workdir "/workspaces/project"
  User node
# DevPod End openclaw-portal.devpod
# Gitea (Tailnet). Dedicated key so the 1Password agent is not offered.
Host gitea.tiger-bushmaster.ts.net
    HostName gitea.tiger-bushmaster.ts.net
    Port 2222
    User git
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519_gitea
    IdentityAgent none

Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
{{- if eq .role "local" }}
    IdentityAgent ~/.1password/agent.sock

# GitHub
Host github.com
    HostName github.com
    User git
    IdentitiesOnly yes
    IdentityAgent ~/.1password/agent.sock

# GitLab
Host gitlab.com
    HostName gitlab.com
    User git
    IdentitiesOnly yes
    IdentityAgent ~/.1password/agent.sock

# Bitbucket
Host bitbucket.org
    HostName bitbucket.org
    User git
    IdentitiesOnly yes
    IdentityAgent ~/.1password/agent.sock

# Coolify
Host 10.20.0.*
    IdentityFile ~/.ssh/id_ed25519_coolify
    IdentitiesOnly yes
    User ubuntu

Host 100.70.96.19
    IdentityFile ~/.ssh/id_ed25519_server
    User root

Host antigravity
    HostName 100.70.96.19
    IdentityFile ~/.ssh/antigravity_key
    IdentitiesOnly yes
    User antigravity-admin

Host ubuntu
    HostName 100.70.96.19
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    User dom
{{- else if eq .role "remote" }}
Host storagebox
    HostName u618588.your-storagebox.de
    User u618588
    Port 23
    IdentityFile ~/.ssh/storagebox_ed25519.pub # Or the exact name of your public key in 1Password
    IdentitiesOnly yes
{{- end }}

{{- if (env "SSH_HETZNER_IP") }}
Host hetzner
    HostName {{ env "SSH_HETZNER_IP" }}
    User {{ env "SSH_HETZNER_USER" }}
    IdentityFile {{ env "SSH_HETZNER_KEY" }}
{{- end }}
{{- end }}

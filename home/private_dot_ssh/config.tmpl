{{- if .modules.ssh -}}
Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
{{- if eq .role "local" }}
    IdentityAgent ~/.1password/agent.sock

# Git forges — prefer 1Password SSH agent when available.
Host github.com
    HostName github.com
    User git
    IdentitiesOnly yes
    IdentityAgent ~/.1password/agent.sock

Host gitlab.com
    HostName gitlab.com
    User git
    IdentitiesOnly yes
    IdentityAgent ~/.1password/agent.sock
{{- end }}
{{- end -}}

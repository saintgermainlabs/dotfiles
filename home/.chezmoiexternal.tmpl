{{- if and (dig "gui" false .) (dig "nautilus_extensions" false .modules) -}}
[".local/share/nautilus-python/extensions"]
type = "archive"
url = "https://github.com/ToFpon/Nautilus-Extensions/archive/refs/heads/main.tar.gz"
stripComponents = 1
refreshPeriod = "168h"
include = [
    "*/annotate-image.py",
    "*/deb-installer.py",
    "*/search-content.py",
    "*/extract-here.py",
    "*/compress-pdf.py",
    "*/merge-pdf.py",
]
{{- end -}}

#!/bin/sh
# Exports the variables in .chezmoidata/env.toml on every `chezmoi apply`.
# Generated from the template; edit env.toml, not this script.

set -u

env_dir="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
env_file="${env_dir}/90-chezmoi.conf"
mkdir -p "$env_dir"

# Write to a temp file and move it into place, so a failure never leaves a half-written file.
tmp="$(mktemp "${env_file}.XXXXXX")" || exit 1
{
  printf '# Generated by chezmoi from .chezmoidata/env.toml. Do not edit.\n'
{{- range $name, $value := .env }}
  printf '%s=%s\n' {{ $name | quote }} {{ $value | quote }}
{{- end }}
} > "$tmp"
mv -f "$tmp" "$env_file"

{{- if .env }}

# Push the variables into the running session: the systemd user manager (for
# services and desktop-launched apps) and the D-Bus activation environment.
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user set-environment \
{{- range $name, $value := .env }}
    {{ printf "%s=%s" $name $value | quote }} \
{{- end }}
    >/dev/null 2>&1 || true
fi
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd \
{{- range $name, $value := .env }}
    {{ printf "%s=%s" $name $value | quote }} \
{{- end }}
    >/dev/null 2>&1 || true
fi
{{- end }}

  "mcp": {
    "servers": {
      "context7": {
        "command": "npx",
        "args": [
          "-y",
          "@upstash/context7-mcp"
        ]
      },
      "docmost": {
        "url": "https://docmost.tiger-bushmaster.ts.net/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${DOCMOST_API_KEY}"
        }
      },
      "coolify-readonly": {
        "url": "https://ubuntu-server.tiger-bushmaster.ts.net/mcp",
        "transport": "streamable-http",
        "headers": {
          "Authorization": "Bearer ${COOLIFY_MCP_TOKEN}"
        },
        "toolFilter": {
          "include": [
            "list_servers",
            "list_applications",
            "list_services",
            "list_databases",
            "get_server",
            "get_application",
            "get_service",
            "get_database",
            "get_server_resources",
            "get_domains",
            "server_resources",
            "server_domains",
            "list_deployments",
            "get_infrastructure_overview",
            "get_version",
            "diagnose_app",
            "diagnose_server",
            "find_issues"
          ]
        }
      },
      "tailscale-readonly": {
        "command": "npx",
        "args": [
          "-y",
          "@hexsleeves/tailscale-mcp-server"
        ],
        "env": {
          "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}",
          "TAILSCALE_TAILNET": "-",
          "TAILSCALE_ALLOWED_TOOL_RISK": "read"
        },
        "toolFilter": {
          "include": [
            "list_devices",
            "get_tailnet_info",
            "get_network_status",
            "get_version",
            "get_version_info",
            "ping_peer"
          ]
        }
      }
    }

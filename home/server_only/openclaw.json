{
  "meta": {
    "lastTouchedVersion": "2026.7.1",
    "lastTouchedAt": "2026-08-06T07:49:02.771Z"
  },
  "wizard": {
    "lastRunAt": "2026-08-04T02:21:34.801Z",
    "lastRunVersion": "2026.7.1",
    "lastRunCommand": "doctor",
    "lastRunMode": "local"
  },
  "browser": {
    "evaluateEnabled": true,
    "cdpUrl": "http://browser:9223",
    "remoteCdpTimeoutMs": 1500,
    "remoteCdpHandshakeTimeoutMs": 3000,
    "defaultProfile": "openclaw",
    "snapshotDefaults": {
      "mode": "efficient"
    },
    "ssrfPolicy": {
      "dangerouslyAllowPrivateNetwork": false,
      "hostnameAllowlist": [
        "*.tiger-bushmaster.ts.net",
        "tiger-bushmaster.ts.net"
      ]
    },
    "profiles": {
      "figma": {
        "cdpUrl": "http://browser:9223",
        "color": "#A259FF"
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/google/gemini-2.5-flash"
      },
      "workspace": "/workspace",
      "sandbox": {
        "mode": "off",
        "scope": "agent",
        "workspaceAccess": "rw",
        "docker": {
          "binds": [
            "/srv/openclaw/sandbox:/sandbox:rw"
          ],
          "dangerouslyAllowExternalBindSources": true
        }
      },
      "maxConcurrent": 3,
      "subagents": {
        "maxConcurrent": 4,
        "archiveAfterMinutes": 60
      }
    }
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw",
    "ownerAllowFrom": [
      "telegram:5475700557"
    ]
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing",
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "groupPolicy": "allowlist",
      "streaming": {
        "mode": "partial"
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "controlUi": {
      "enabled": true,
      "allowedOrigins": [
        "https://openclaw.tiger-bushmaster.ts.net"
      ],
      "allowInsecureAuth": false
    },
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}",
      "allowTailscale": true,
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    "reload": {
      "mode": "hybrid",
      "debounceMs": 300
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true,
        "config": {}
      },
      "memory-core": {
        "config": {}
      },
      "openrouter": {
        "enabled": true
      },
      "browser": {
        "enabled": true
      },
      "memory-wiki": {
        "enabled": true,
        "config": {
          "vaultMode": "isolated",
          "vault": {
            "path": "/knowledge/memory"
          },
          "render": {
            "preserveHumanBlocks": true,
            "createBacklinks": true,
            "createDashboards": true
          }
        }
      },
      "perplexity": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": "${OPENROUTER_API_KEY}"
          }
        }
      },
      "searxng": {
        "enabled": true,
        "config": {
          "webSearch": {
            "baseUrl": "http://openclaw-searxng:8080",
            "categories": "general",
            "language": "en"
          }
        }
      },
      "lossless-claw": {
        "enabled": true
      },
      "acpx": {
        "enabled": true
      },
      "workboard": {
        "enabled": true
      }
    },
    "slots": {
      "contextEngine": "lossless-claw"
    }
  },
  "cron": {
    "maxConcurrentRuns": 8
  },

#!/usr/bin/python3
"""Resource watchdog (BALANCED): kill runaway user processes.

Rules:
  - CPU: same process stays >= 90% for ~20s (poll every 2s → 10 consecutive samples)
  - RAM: if system memory used > 95%, SIGTERM the most-unused heavy process
    (highest rss / (1 + recent_cpu%) — big but idle goes first)
    (never root / system processes)
  - Protected (never killed): IDEs, editors and coding agents, matched
    case-insensitively (regex) on process name, exe path and cmdline.
    Patterns: ~/.config/resource-watchdog/protected.txt (seeded with defaults,
    re-read when it changes). Lines starting with "child:" are regexes for
    process kinds (node/python/language servers) that are also protected
    when ANY ancestor is protected (IDE extension hosts, LSPs, agent helpers).
  - If the top offender is protected, the next unprotected offender is used.
    If only protected processes are hogging: log + notify, never kill.

Env:
  RESOURCE_WATCHDOG_DRY_RUN=1  — log only, never signal
"""
from __future__ import annotations

import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

POLL_SEC = 2.0
CPU_THRESHOLD = 90.0          # percent of one core
CPU_STREAK_NEEDED = 10        # 10 * 2s ≈ 20s
MEM_USED_THRESHOLD = 0.95     # system-wide
COOLDOWN_SEC = 30.0
TERM_WAIT_SEC = 3.0
LOG_PATH = Path.home() / ".cache" / "resource-watchdog.log"

DRY_RUN = os.environ.get("RESOURCE_WATCHDOG_DRY_RUN", "").strip() in ("1", "true", "yes")
MY_UID = os.getuid()
MY_PID = os.getpid()

# Basename / substring deny-list (case-sensitive match on comm or argv0 basename).
PROTECTED_EXACT = {
    "systemd", "systemd-journald", "systemd-logind", "systemd-resolved",
    "systemd-udevd", "systemd-timesyncd", "systemd-networkd",
    "dbus-daemon", "dbus-broker", "dbus-broker-launch",
    "pipewire", "pipewire-pulse", "pipewire-media-session",
    "pulseaudio", "wireplumber",
    "Xorg", "Xwayland", "X",
    "gnome-shell", "cinnamon", "mutter", "cinnamon-session", "gnome-session",
    "gdm", "gdm3", "gdm-session-worker", "lightdm", "sddm", "sddm-helper",
    "sshd", "ssh", "NetworkManager", "nm-dispatcher",
    "resource-watchdog",
    "init",
}
PROTECTED_PREFIXES = (
    "systemd-", "gdm-", "gnome-", "cinnamon-", "pipewire", "xdg-desktop-portal",
)
PROTECTED_FILE = Path.home() / ".config" / "resource-watchdog" / "protected.txt"
MEM_MIN_RSS = 256 * 1024 * 1024   # an unprotected RAM victim must be at least this big
ALERT_COOLDOWN_SEC = 300.0        # min gap between "only protected hogging" alerts

DEFAULT_PROTECTED = """\
# resource-watchdog protected processes — one case-insensitive regex per line.
# Each pattern is searched in: process name (comm), exe path, and full cmdline.
# Lines starting with "child:" match process kinds that are protected only when
# an ancestor (parent, grandparent, ...) is protected.  '#' starts a comment.

# --- Dyad
\\bdyad\\b
# --- VS Code (binary, insiders, OSS, helper processes, electron running Code)
(^|/)code(-insiders|-oss)?($|\\s)
code helper
/usr/share/code(-insiders)?/
electron.*/code/
/code/.*electron
# --- Other IDEs / editors
vscodium|(^|/)codium\\b
\\bcursor\\b
\\bqoder\\b
\\bwindsurf\\b
\\bzed(-editor)?\\b|dev\\.zed\\.
\\bkiro\\b
antigravity
jetbrains|(^|/)idea(\\.sh)?($|\\s)|-didea\\.|\\b(pycharm|webstorm|goland|clion|rustrover|rust-rover|phpstorm|rubymine|datagrip|fleet)\\b
sublime_text|(^|/)subl($|\\s)
(^|/)(emacs|emacsclient|vim|nvim|geany|kate|xed|mousepad)($|\\s)
# --- Coding agents
\\bclaude\\b
\\bgrok\\b|grok[-_ ]?bot
\\bcodex\\b
\\bgemini\\b
\\bkilo(code)?\\b
\\bopencode\\b
\\baider\\b
nimbalyst

# --- Descendants of protected processes that are spared too
child:^(node|nodejs|bun|deno|python[0-9.]*|java)$
child:language.?server|languageserver|\\blsp\\b|-lsp\\b|\\b(pyright|pylance|tsserver|typescript-language|gopls|rust-analyzer|clangd|jdtls|omnisharp|lua-language|bash-language|yaml-language|vscode-.*-server)
child:extensionhost|extension-host|ptyhost|fileWatcher
"""

_pat_cache: dict = {"mtime": None, "self": [], "child": []}


def load_patterns() -> tuple[list, list]:
    """Return (self_patterns, child_patterns); seed the file if missing."""
    try:
        if not PROTECTED_FILE.exists():
            PROTECTED_FILE.parent.mkdir(parents=True, exist_ok=True)
            PROTECTED_FILE.write_text(DEFAULT_PROTECTED, encoding="utf-8")
            log(f"seeded {PROTECTED_FILE}")
        mtime = PROTECTED_FILE.stat().st_mtime
        text = None if mtime == _pat_cache["mtime"] else PROTECTED_FILE.read_text(encoding="utf-8")
    except OSError as e:
        if _pat_cache["mtime"] is None:
            log(f"cannot read {PROTECTED_FILE} ({e}); using built-in defaults")
            mtime, text = -1, DEFAULT_PROTECTED
        else:
            return _pat_cache["self"], _pat_cache["child"]
    if text is not None:
        selfp, childp = [], []
        for raw in text.splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            target = selfp
            if line.lower().startswith("child:"):
                target, line = childp, line[6:].strip()
            try:
                target.append(re.compile(line, re.IGNORECASE))
            except re.error as e:
                log(f"bad pattern in {PROTECTED_FILE}: {line!r}: {e}")
        _pat_cache.update(mtime=mtime, self=selfp, child=childp)
        log(f"loaded {len(selfp)} protected + {len(childp)} child patterns")
    return _pat_cache["self"], _pat_cache["child"]


def _matches(pats: list, fields: tuple) -> str | None:
    for rx in pats:
        for f in fields:
            if f and rx.search(f):
                return rx.pattern
    return None


def log(msg: str) -> None:
    line = time.strftime("%Y-%m-%d %H:%M:%S") + " " + msg
    try:
        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with LOG_PATH.open("a", encoding="utf-8") as f:
            f.write(line + "\n")
    except OSError:
        pass
    try:
        print(line, flush=True)
    except OSError:
        pass


def notify(title: str, body: str) -> None:
    if DRY_RUN:
        return
    try:
        subprocess.Popen(
            ["notify-send", "--app-name=Resource Watchdog", "-u", "critical", title, body],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


def clk_tck() -> int:
    try:
        return os.sysconf(os.sysconf_names["SC_CLK_TCK"])
    except (AttributeError, ValueError, OSError):
        return 100


CLK = clk_tck()


def meminfo() -> tuple[float, float]:
    """Return (used_ratio, total_bytes). used = 1 - MemAvailable/MemTotal."""
    total = avail = 0
    try:
        with open("/proc/meminfo", encoding="utf-8") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    total = int(line.split()[1]) * 1024
                elif line.startswith("MemAvailable:"):
                    avail = int(line.split()[1]) * 1024
    except OSError:
        return 0.0, 0
    if total <= 0:
        return 0.0, 0
    return max(0.0, min(1.0, 1.0 - (avail / total))), total


def is_system_protected(pid: int, comm: str, exe_base: str) -> bool:
    if pid <= 1 or pid == MY_PID:
        return True
    # Kernel threads: comm in brackets
    if comm.startswith("[") and comm.endswith("]"):
        return True
    for n in (comm, exe_base):
        if not n:
            continue
        if n in PROTECTED_EXACT:
            return True
        for pref in PROTECTED_PREFIXES:
            if n.startswith(pref):
                return True
    return False


def classify(procs: list) -> None:
    """Set proc['protected'] (reason str or None): own match, or child-kind with a protected ancestor."""
    selfp, childp = load_patterns()
    by_pid = {p["pid"]: p for p in procs}
    for p in procs:
        p["self_match"] = _matches(selfp, (p["comm"], p["exe"], p["cmdline"]))
    ppid_of: dict[int, int] = {}

    def ppid(pid: int) -> int:
        if pid in by_pid:
            return by_pid[pid]["ppid"]
        if pid not in ppid_of:
            try:
                with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as f:
                    st = f.read()
                ppid_of[pid] = int(st[st.rfind(")") + 2 :].split()[1])
            except (OSError, ValueError, IndexError):
                ppid_of[pid] = 0
        return ppid_of[pid]

    for p in procs:
        if p["self_match"]:
            p["protected"] = f"match:{p['self_match']}"
            continue
        p["protected"] = None
        if not _matches(childp, (p["comm"], os.path.basename(p["exe"]), p["cmdline"])):
            continue
        cur, hops = p["ppid"], 0
        while cur > 1 and hops < 64:
            anc = by_pid.get(cur)
            if anc is not None and anc.get("self_match"):
                p["protected"] = f"child-of:{anc['name']}({cur})"
                break
            cur, hops = ppid(cur), hops + 1


def iter_user_procs():
    """Yield dicts for processes owned by MY_UID."""
    try:
        pids = [int(e) for e in os.listdir("/proc") if e.isdigit()]
    except OSError:
        return
    for pid in pids:
        if pid <= 1 or pid == MY_PID:
            continue
        base = f"/proc/{pid}"
        try:
            st = os.stat(base)
            if st.st_uid != MY_UID:
                continue
            with open(f"{base}/stat", encoding="utf-8", errors="replace") as f:
                stat_line = f.read()
            # comm is in parentheses and may contain spaces; split carefully
            lpar = stat_line.find("(")
            rpar = stat_line.rfind(")")
            if lpar < 0 or rpar < 0:
                continue
            comm = stat_line[lpar + 1 : rpar]
            rest = stat_line[rpar + 2 :].split()
            # fields after comm: state(0), ppid(1), ... utime(11), stime(12), ... rss(21)
            if len(rest) < 22:
                continue
            ppid_v = int(rest[1])
            utime = int(rest[11])
            stime = int(rest[12])
            rss_pages = int(rest[21])
            rss = rss_pages * os.sysconf("SC_PAGESIZE")
            try:
                exe = os.readlink(f"{base}/exe")
            except OSError:
                exe = ""
            exe_base = os.path.basename(exe)
            if is_system_protected(pid, comm, exe_base):
                continue
            try:
                with open(f"{base}/cmdline", "rb") as f:
                    cmdline = f.read(8192).replace(b"\x00", b" ").decode("utf-8", errors="replace").strip()
            except OSError:
                cmdline = ""
            yield {
                "pid": pid,
                "ppid": ppid_v,
                "name": exe_base or comm,
                "comm": comm,
                "exe": exe,
                "cmdline": cmdline,
                "jiffies": utime + stime,
                "rss": rss,
            }
        except (OSError, ValueError, IndexError):
            continue


def kill_process(proc: dict, reason: str, cpu: float | None, mem_ratio: float) -> None:
    pid = proc["pid"]
    name = proc["name"]
    if proc.get("protected"):
        log(f"refusing to kill protected pid={pid} name={name} ({proc['protected']})")
        return
    rss_mb = proc["rss"] / (1024 * 1024)
    cpu_s = f"{cpu:.1f}%" if cpu is not None else "n/a"
    mem_s = f"{mem_ratio * 100:.1f}%"
    prefix = "DRY-RUN would kill" if DRY_RUN else "Killing"
    log(
        f"{prefix} pid={pid} name={name} reason={reason} "
        f"cpu={cpu_s} rss_mb={rss_mb:.1f} sys_mem={mem_s}"
    )
    notify(
        "Resource watchdog",
        f"{'Would kill' if DRY_RUN else 'Killed'} {name} (pid {pid})\n"
        f"reason={reason} cpu={cpu_s} rss={rss_mb:.0f}MiB",
    )
    if DRY_RUN:
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError as e:
        log(f"SIGTERM failed pid={pid}: {e}")
        return
    deadline = time.monotonic() + TERM_WAIT_SEC
    while time.monotonic() < deadline:
        if not os.path.exists(f"/proc/{pid}"):
            log(f"pid={pid} exited after SIGTERM")
            return
        time.sleep(0.25)
    try:
        os.kill(pid, signal.SIGKILL)
        log(f"SIGKILL sent pid={pid} name={name}")
    except OSError as e:
        log(f"SIGKILL failed pid={pid}: {e}")


_last_alert = {"t": 0.0}


def alert_protected(proc: dict, reason: str, cpu: float | None, mem_ratio: float) -> None:
    """Log every time (throttled per cooldown); notify at most every ALERT_COOLDOWN_SEC."""
    now = time.monotonic()
    rss_mb = proc["rss"] / (1024 * 1024)
    cpu_s = f"{cpu:.1f}%" if cpu is not None else "n/a"
    log(f"PROTECTED hog, not killing: pid={proc['pid']} name={proc['name']} reason={reason} "
        f"cpu={cpu_s} rss_mb={rss_mb:.1f} sys_mem={mem_ratio * 100:.1f}% ({proc['protected']})")
    if now - _last_alert["t"] >= ALERT_COOLDOWN_SEC:
        _last_alert["t"] = now
        notify("Resource watchdog — protected process hogging",
               f"{proc['name']} (pid {proc['pid']}) {reason}\ncpu={cpu_s} rss={rss_mb:.0f}MiB — not killed")


def main() -> int:
    load_patterns()
    log(
        f"started uid={MY_UID} pid={MY_PID} dry_run={int(DRY_RUN)} "
        f"cpu>={CPU_THRESHOLD}% for {CPU_STREAK_NEEDED * POLL_SEC:.0f}s "
        f"or sys_mem>{MEM_USED_THRESHOLD * 100:.0f}%"
    )
    # pid -> (last_jiffies, streak_count)
    cpu_state: dict[int, tuple[int, int]] = {}
    last_sample = time.monotonic()
    last_kill = 0.0
    last_protected_log: dict[int, float] = {}

    while True:
        time.sleep(POLL_SEC)
        now = time.monotonic()
        dt = max(0.001, now - last_sample)
        last_sample = now

        mem_ratio, _total = meminfo()
        procs = list(iter_user_procs())
        classify(procs)
        seen = set()

        # Snapshot before the CPU loop mutates cpu_state, so the RAM scorer
        # can compute recent CPU% from the *previous* interval's jiffies.
        prev_cpu_state = dict(cpu_state)

        # --- CPU streak ---
        for proc in procs:
            pid = proc["pid"]
            seen.add(pid)
            prev = cpu_state.get(pid)
            jiffies = proc["jiffies"]
            if prev is None:
                cpu_state[pid] = (jiffies, 0)
                continue
            prev_j, streak = prev
            delta_j = max(0, jiffies - prev_j)
            cpu_pct = (delta_j / CLK) / dt * 100.0
            if cpu_pct >= CPU_THRESHOLD:
                streak += 1
            else:
                streak = 0
            cpu_state[pid] = (jiffies, streak)

            if streak >= CPU_STREAK_NEEDED and proc["protected"]:
                if now - last_protected_log.get(pid, 0.0) >= COOLDOWN_SEC:
                    last_protected_log[pid] = now
                    alert_protected(proc, f"cpu>={CPU_THRESHOLD}%_for_{int(CPU_STREAK_NEEDED * POLL_SEC)}s",
                                    cpu_pct, mem_ratio)
                continue  # try the next (unprotected) offender
            if streak >= CPU_STREAK_NEEDED and (now - last_kill) >= COOLDOWN_SEC:
                kill_process(proc, f"cpu>={CPU_THRESHOLD}%_for_{int(CPU_STREAK_NEEDED * POLL_SEC)}s",
                             cpu_pct, mem_ratio)
                last_kill = now
                cpu_state[pid] = (jiffies, 0)
                break  # one kill per loop / cooldown

        # Drop disappeared pids
        for pid in list(cpu_state):
            if pid not in seen:
                del cpu_state[pid]
        for pid in list(last_protected_log):
            if pid not in seen:
                del last_protected_log[pid]

        # --- System RAM pressure: most-unused heavy process ---
        # Pick the process with the highest score = rss / (1 + recent_cpu_pct).
        # This kills big memory hogs that are idle, sparing active ones.
        if mem_ratio > MEM_USED_THRESHOLD and (now - last_kill) >= COOLDOWN_SEC:
            if procs:
                scored = []
                for p in procs:
                    prev = prev_cpu_state.get(p["pid"])
                    if prev is not None:
                        delta_j = max(0, p["jiffies"] - prev[0])
                        cpu_pct = (delta_j / CLK) / dt * 100.0
                    else:
                        cpu_pct = 0.0
                    score = p["rss"] / (1.0 + cpu_pct)
                    scored.append((score, cpu_pct, p))
                scored.sort(key=lambda t: t[0], reverse=True)
                reason = f"sys_mem>{MEM_USED_THRESHOLD * 100:.0f}%_most_unused_heavy"
                skipped = []
                victim = None
                for score, cpu_pct, p in scored:
                    if p["protected"]:
                        skipped.append((cpu_pct, p))
                        continue
                    if p["rss"] >= MEM_MIN_RSS:
                        victim = (cpu_pct, p)
                    break  # highest-ranked unprotected decides
                for cpu_pct, p in skipped[:3]:
                    log(f"skip protected top offender pid={p['pid']} name={p['name']} "
                        f"rss_mb={p['rss'] / 1048576:.0f} ({p['protected']})")
                if victim:
                    kill_process(victim[1], reason, victim[0], mem_ratio)
                elif skipped:
                    alert_protected(skipped[0][1], reason + "_only_protected_hogging",
                                    skipped[0][0], mem_ratio)
                last_kill = now  # cooldown applies to alerts too


if __name__ == "__main__":
    try:
        sys.exit(main() or 0)
    except KeyboardInterrupt:
        log("stopped (KeyboardInterrupt)")
        sys.exit(0)

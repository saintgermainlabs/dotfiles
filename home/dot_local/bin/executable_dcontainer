#!/usr/bin/env python3
"""Find and operate on local or remote Docker containers."""

from __future__ import annotations

import argparse
import shlex
import subprocess
import sys
from dataclasses import dataclass
from typing import Optional, Sequence


def find_container(label_query: str) -> Optional[str]:
    """Find a local container by ``app.name`` and ``app.component`` labels."""
    try:
        import docker
    except ImportError as exc:
        raise RuntimeError("Install the local dependency with: pip install docker") from exc

    parts = label_query.split(".", 1)
    if len(parts) < 2 or not all(parts):
        raise ValueError("Label query must be in the format 'app_name.app_component'")

    app_name, app_component = parts
    containers = docker.from_env().containers.list(
        filters={
            "label": [
                f"app.name={app_name}",
                f"app.component={app_component}",
            ]
        }
    )
    return containers[0].name if containers else None


def _select_container(names: Sequence[str], query: str) -> Optional[str]:
    if not names:
        print(f"No containers found matching query: {query!r}", file=sys.stderr)
        return None
    if len(names) == 1:
        return names[0]

    print(f"Multiple containers found matching {query!r}:")
    for index, name in enumerate(names, 1):
        print(f"  [{index}] {name}")

    while True:
        try:
            choice = int(input("Select a container number: ").strip())
            if 1 <= choice <= len(names):
                return names[choice - 1]
        except ValueError:
            pass
        print(f"Please enter a number between 1 and {len(names)}.")


def find_container_fuzzy(query: str) -> Optional[str]:
    """Find a local container by a case-sensitive name substring."""
    try:
        import docker
    except ImportError as exc:
        raise RuntimeError("Install the local dependency with: pip install docker") from exc

    containers = docker.from_env().containers.list(filters={"name": query})
    return _select_container([container.name for container in containers], query)


@dataclass(frozen=True)
class Runner:
    remote: bool = False
    host: str = "ubuntu"

    def run(
        self,
        command: Sequence[str],
        *,
        interactive: bool = False,
        capture: bool = False,
    ) -> subprocess.CompletedProcess[str]:
        if self.remote:
            # Quote every argument before handing the command to the remote shell.
            remote_command = shlex.join(list(command))
            argv = ["ssh"]
            if interactive:
                argv.append("-t")
            argv.extend([self.host, remote_command])
        else:
            argv = list(command)

        return subprocess.run(
            argv,
            check=False,
            text=True,
            capture_output=capture,
        )

    def docker_output(self, args: Sequence[str]) -> list[str]:
        result = self.run(["docker", *args], capture=True)
        if result.returncode:
            message = (result.stderr or result.stdout).strip()
            raise RuntimeError(message or "Docker command failed")
        return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def find_remote_container(runner: Runner, label_query: str) -> Optional[str]:
    parts = label_query.split(".", 1)
    if len(parts) < 2 or not all(parts):
        raise ValueError("Label query must be in the format 'app_name.app_component'")
    app_name, app_component = parts
    names = runner.docker_output(
        [
            "ps",
            "--filter",
            f"label=app.name={app_name}",
            "--filter",
            f"label=app.component={app_component}",
            "--format",
            "{{.Names}}",
        ]
    )
    return names[0] if names else None


def find_remote_container_fuzzy(runner: Runner, query: str) -> Optional[str]:
    names = runner.docker_output(["ps", "--format", "{{.Names}}"])
    return _select_container([name for name in names if query in name], query)


def resolve_container(runner: Runner, query: str, fuzzy: bool) -> Optional[str]:
    if runner.remote:
        return (
            find_remote_container_fuzzy(runner, query)
            if fuzzy
            else find_remote_container(runner, query)
        )
    return find_container_fuzzy(query) if fuzzy else find_container(query)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Find and operate on Docker containers locally or over SSH."
    )
    parser.add_argument(
        "-r",
        "--remote",
        action="store_true",
        help="run Docker commands remotely over SSH (default host: ubuntu)",
    )
    parser.add_argument(
        "--host",
        default="ubuntu",
        help="SSH host or user@host used with --remote (default: ubuntu)",
    )
    parser.add_argument(
        "-f",
        "--fuzzy",
        action="store_true",
        help="treat QUERY as a container-name substring instead of app labels",
    )

    subparsers = parser.add_subparsers(dest="command", required=True)
    for command, help_text in (
        ("get", "print the matching container name"),
        ("restart", "restart the matching container"),
        ("sh", "open an interactive shell in the matching container"),
    ):
        subparser = subparsers.add_parser(command, help=help_text)
        subparser.add_argument("query")

    exec_parser = subparsers.add_parser("exec", help="execute a command in the container")
    exec_parser.add_argument("query")
    exec_parser.add_argument(
        "container_command",
        nargs=argparse.REMAINDER,
        metavar="COMMAND",
        help="command and arguments; use -- before options intended for the command",
    )

    find_parser = subparsers.add_parser("find", help="find files in the container")
    find_parser.add_argument("query")
    find_parser.add_argument("pattern", help="find -name pattern, for example '*.log'")
    find_parser.add_argument("--root", default="/", help="directory to search (default: /)")
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    runner = Runner(remote=args.remote, host=args.host)

    try:
        container = resolve_container(runner, args.query, args.fuzzy)
        if container is None:
            return 1

        if args.command == "get":
            print(container)
            return 0
        if args.command == "restart":
            return runner.run(["docker", "restart", container]).returncode
        if args.command == "sh":
            return runner.run(
                ["docker", "exec", "-it", container, "sh"], interactive=True
            ).returncode
        if args.command == "exec":
            command = list(args.container_command)
            if command[:1] == ["--"]:
                command = command[1:]
            if not command:
                raise ValueError("exec requires a command")
            return runner.run(["docker", "exec", container, *command]).returncode
        if args.command == "find":
            return runner.run(
                ["docker", "exec", container, "find", args.root, "-name", args.pattern]
            ).returncode
    except (RuntimeError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    return 2


if __name__ == "__main__":
    raise SystemExit(main())

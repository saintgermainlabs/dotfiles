# Safe, non-secret defaults for the HashiCorp Vault shell module.

VAULT_ADDR="https://vault.tiger-bushmaster.ts.net"
VAULT_OIDC_ROLE="inventory"
VAULT_TRANSIT_MOUNT="transit"
VAULT_TRANSIT_KEY="inventory"
VAULT_KV_MOUNT="secret"
VAULT_APPROLE_MOUNT="approle"
VAULT_APPROLE_NAME="py-server-manage"

# Do not commit values for any of the following:
#
# VAULT_TOKEN
# VAULT_ROLE_ID
# VAULT_SECRET_ID
#
# Prefer protected runtime files:
#
# VAULT_ROLE_ID_FILE="/run/secrets/vault_role_id"
# VAULT_SECRET_ID_FILE="/run/secrets/vault_secret_id"


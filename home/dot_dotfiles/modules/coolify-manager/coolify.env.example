# Safe, non-secret defaults for the Coolify manager shell module.
# Copy to ~/.config/coolify-manager/environment (mode 0600) if you need overrides.

# Optional Coolify CLI context name (from `coolify context list`).
# Leave empty to use the CLI default context.
# COOLIFY_CONTEXT="default"

# Coolify data root on the managed server (used by coolify_find_app_path).
COOLIFY_DATA_DIR="/data/coolify"

# API tokens belong in the Coolify CLI config, not here:
#   ~/.config/coolify/config.json
#   coolify context add -d <name> <url> <token>

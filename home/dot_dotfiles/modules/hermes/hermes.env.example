# Safe, non-secret defaults for the remote Hermes shell module.
# Copy to ~/.config/hermes/environment (mode 0600) if you need overrides.

HERMES_SSH_HOST="ubuntu"

# Pin after a Coolify recreate if auto-discovery picks the wrong container:
# HERMES_APP_CONTAINER="hermes-xxxxxxxxxxxxxxxxxxxx"

# Extra ssh options (BatchMode is fine for most commands):
# HERMES_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10"

# Editor used by hm_config_edit (must wait for the window to close):
# HERMES_CONFIG_EDITOR="subl -w"

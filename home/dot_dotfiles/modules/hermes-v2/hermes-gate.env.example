# Safe, non-secret defaults for the Hermes Gate shell module.
# Copy to ~/.config/hermes-gate/environment (mode 0600) if you need overrides.

# Local git checkout (not managed by chezmoi):
# HERMES_GATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/hermes-gate"

# Upstream repository:
# HERMES_GATE_REPO="https://github.com/LehaoLin/hermes-gate.git"

# Docker container name used by upstream run.sh:
# HERMES_GATE_CONTAINER="hermes-gate"

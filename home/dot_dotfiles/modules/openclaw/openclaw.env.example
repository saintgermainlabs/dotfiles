# Safe, non-secret defaults for the remote OpenClaw shell module.
# Copy to ~/.config/openclaw/environment (mode 0600) if you need overrides.

OPENCLAW_SSH_HOST="ubuntu"

# Pin after a Coolify recreate if auto-discovery picks the wrong container:
# OPENCLAW_APP_CONTAINER="openclaw-syowig5e8r47c96qh26btdc0"

# Always pass --acknowledge-clawhub-risk on skill installs (1) or never (0).
# Leave unset for auto: ack when stdin is not a TTY.
# OPENCLAW_ACK_CLAWHUB_RISK=1

# Extra ssh options (BatchMode is fine for most commands):
# OPENCLAW_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10"

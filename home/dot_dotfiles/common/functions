# Common helper functions (bash and zsh).

# Return success when a command is installed.
has() {
  command -v "$1" >/dev/null 2>&1
}

# Create a directory and cd into it.
# Usage: mkcd <directory>
mkcd() {
  if [ "$#" -ne 1 ]; then
    printf 'Usage: mkcd <directory>\n' >&2
    return 2
  fi
  mkdir -p -- "$1" && cd -- "$1"
}

# Go up N directories (default 1).
# Usage: up [positive-integer]
up() {
  local levels="${1:-1}"
  local destination=""

  case "$levels" in
    ''|*[!0-9]*)
      printf 'Usage: up [positive-integer]\n' >&2
      return 2
      ;;
  esac

  while [ "$levels" -gt 0 ]; do
    destination="../${destination}"
    levels=$((levels - 1))
  done

  cd -- "$destination"
}

# Create a gzip-compressed tarball named after a path.
compress() { tar -czf "${1%/}.tar.gz" "${1%/}"; }
# Extract a .tar.gz archive.
alias decompress='tar -xzf'

# Extract a common archive format by extension.
# Usage: extract <archive>
extract() {
  if [ "$#" -ne 1 ]; then
    printf 'Usage: extract <archive>\n' >&2
    return 2
  fi

  local archive="$1"
  if [ ! -f "$archive" ]; then
    printf 'File not found: %s\n' "$archive" >&2
    return 1
  fi

  case "$archive" in
    *.tar.bz2|*.tbz2) tar -xjf "$archive" ;;
    *.tar.gz|*.tgz)   tar -xzf "$archive" ;;
    *.tar.xz|*.txz)   tar -xJf "$archive" ;;
    *.tar.zst)        tar --zstd -xf "$archive" ;;
    *.tar)            tar -xf "$archive" ;;
    *.bz2)            bunzip2 "$archive" ;;
    *.gz)             gunzip "$archive" ;;
    *.xz)             unxz "$archive" ;;
    *.zip)            unzip "$archive" ;;
    *.7z)             7z x "$archive" ;;
    *)
      printf 'Unsupported archive format: %s\n' "$archive" >&2
      return 1
      ;;
  esac
}

# Activate a Python virtualenv found in the current tree (.venv, venv, …).
venv() {
  local candidate candidates=()
  for candidate in .venv venv .env env; do
    if [ -f "$candidate/bin/activate" ]; then
      candidates+=("$candidate")
    fi
  done

  if [ ${#candidates[@]} -eq 0 ]; then
    echo "venv: No virtual environment found." >&2
    return 1
  elif [ ${#candidates[@]} -eq 1 ]; then
    # shellcheck disable=SC1090
    . "${candidates[0]}/bin/activate"
  else
    echo "Multiple virtual environments found:" >&2
    printf '  %s\n' "${candidates[@]}" >&2
    return 1
  fi
}


# SSH Related Functions

# Generate a new SSH deploy key
new_deploy_key() {
    local key_name="$1"
    local key_dir="$HOME/.ssh/deploy-keys"

    # Validate argument
    if [ -z "$key_name" ]; then
        echo "Error: Please provide a name for the deploy key."
        echo "Usage: new_deploy_key <key-name>"
        return 1
    fi

    local key_path="$key_dir/$key_name"

    # Ensure the deploy-keys directory exists with correct permissions (700)
    if [ ! -d "$key_dir" ]; then
        echo "Creating directory: $key_dir"
        mkdir -p "$key_dir"
        chmod 700 "$key_dir"
    fi

    # Check if key already exists
    if [ -f "$key_path" ]; then
        echo "Error: Key already exists at $key_path"
        return 1
    fi

    # Generate the Ed25519 SSH key (no passphrase for automated deployments)
    echo "Generating SSH key: $key_path"
    ssh-keygen -t ed25519 -C "$key_name-deploy-key" -f "$key_path" -N ""

    # Set strict permissions on the private key (600)
    chmod 600 "$key_path"

    echo ""
    echo "=========================================="
    echo " Success! Here is your PUBLIC key:"
    echo "=========================================="
    cat "${key_path}.pub"
    echo "=========================================="
    echo "Private key saved to: $key_path"
}







# Common helper functions (bash and zsh).



## @description Creates a directory, including missing parent directories, and changes into it.
## @category Helpers
## @arg $1 string The directory path to create and enter.
## @exitcode 0 If the directory was created or already existed and the directory change succeeded.
## @exitcode 1 If mkdir or cd fails.
## @exitcode 2 If exactly one argument is not provided.
## @stderr Prints usage information when called with an invalid number of arguments.
## @example
##   mkcd ~/projects/example
## @see mkdir(1)
## @see cd(1)
mkcd() {
  if [ "$#" -ne 1 ]; then
    printf 'Usage: mkcd <directory>\n' >&2
    return 2
  fi
  mkdir -p -- "$1" && cd -- "$1"
}

## @description Moves upward through the directory hierarchy by a specified number of levels.
## @category Helpers
## @arg $1 integer Optional number of directory levels to ascend. Defaults to 1.
## @exitcode 0 If the directory change succeeds.
## @exitcode 1 If cd fails.
## @exitcode 2 If the supplied argument is not a non-negative integer.
## @stderr Prints usage information when the argument is invalid.
## @example
##   up
##   up 3
## @see cd(1)
up() {
  local levels="${1:-1}"
  local destination=""

  case "$levels" in
    ''|*[!0-9]*)
      printf 'Usage: up [positive-integer]\n' >&2
      return 2
      ;;
  esac

  while [ "$levels" -gt 0 ]; do
    destination="../${destination}"
    levels=$((levels - 1))
  done

  cd -- "$destination"
}

## @description Runs chezmoi apply, but automatically skips any file that was changed outside chezmoi.
## @description Files whose current contents differ from what chezmoi last wrote are left untouched and listed; everything else is applied without prompting.
## @category Helpers
## @arg $@ string Optional extra flags passed to chezmoi apply (e.g. -v, --dry-run).
## @exitcode 0 If all non-conflicting targets were applied (or nothing needed applying).
## @exitcode 1 If chezmoi is missing or chezmoi apply fails.
## @stdout Prints the skipped files and the number of files applied.
## @stderr Prints chezmoi errors.
## @example
##   czapply
##   czapply -v --dry-run
## @see chezmoi(1)
czapply() {
  if ! command -v chezmoi >/dev/null 2>&1; then
    printf 'Error: chezmoi not found.\n' >&2
    return 1
  fi

  local status_out line first second rel_path
  local -a apply_targets skipped
  apply_targets=()
  skipped=()

  status_out="$(chezmoi status)" || return 1

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    first="${line:0:1}"
    second="${line:1:1}"
    rel_path="${line:3}"
    if [ "$first" != " " ]; then
      # Changed on disk since chezmoi last wrote it: skip.
      skipped+=("$rel_path")
    elif [ "$second" != " " ]; then
      apply_targets+=("$HOME/$rel_path")
    fi
  done <<< "$status_out"

  if [ "${#skipped[@]}" -gt 0 ]; then
    printf 'Skipping %d locally modified file(s):\n' "${#skipped[@]}"
    printf '  ~/%s\n' "${skipped[@]}"
  fi

  if [ "${#apply_targets[@]}" -eq 0 ]; then
    printf 'Nothing to apply.\n'
    return 0
  fi

  chezmoi apply --no-tty "$@" -- "${apply_targets[@]}" || return 1
  printf 'Applied %d file(s).\n' "${#apply_targets[@]}"
}

## @description Creates a gzip-compressed tar archive from a file or directory.
## @category Archives
## @arg $1 string The path to archive. A trailing slash is removed when constructing the archive name.
## @exitcode 0 If the archive is created successfully.
## @exitcode 1 If tar fails.
## @example
##   compress ~/Documents
##   # Creates ~/Documents.tar.gz
## @see tar(1)
compress() {
  tar -czf "${1%/}.tar.gz" "${1%/}"
}

## @description Extracts a gzip-compressed tar archive into the current directory.
## @arg $1 string The path to a .tar.gz or compatible gzip-compressed tar archive.
## @see tar(1)
alias decompress='tar -xzf'

## @description Extracts an archive using the appropriate utility based on its filename extension.
## @category Archives
## @arg $1 string The archive file to extract.
## @exitcode 0 If the archive is extracted successfully.
## @exitcode 1 If the archive does not exist, its format is unsupported, or the extraction utility fails.
## @exitcode 2 If exactly one argument is not provided.
## @stderr Prints an error if the archive does not exist, the format is unsupported, or the argument count is invalid.
## @example
##   extract backup.tar.gz
##   extract package.zip
##   extract archive.7z
## @see tar(1)
## @see bunzip2(1)
## @see gunzip(1)
## @see unxz(1)
## @see unzip(1)
## @see 7z(1)
extract() {
  if [ "$#" -ne 1 ]; then
    printf 'Usage: extract <archive>\n' >&2
    return 2
  fi

  local archive="$1"
  if [ ! -f "$archive" ]; then
    printf 'File not found: %s\n' "$archive" >&2
    return 1
  fi

  case "$archive" in
    *.tar.bz2|*.tbz2) tar -xjf "$archive" ;;
    *.tar.gz|*.tgz)   tar -xzf "$archive" ;;
    *.tar.xz|*.txz)   tar -xJf "$archive" ;;
    *.tar.zst)        tar --zstd -xf "$archive" ;;
    *.tar)            tar -xf "$archive" ;;
    *.bz2)            bunzip2 "$archive" ;;
    *.gz)             gunzip "$archive" ;;
    *.xz)             unxz "$archive" ;;
    *.zip)            unzip "$archive" ;;
    *.7z)             7z x "$archive" ;;
    *)
      printf 'Unsupported archive format: %s\n' "$archive" >&2
      return 1
      ;;
  esac
}


## @description Activates a Python virtual environment found in the current directory.
## @description Searches for .venv, venv, .env, and env directories containing bin/activate.
## @category Python Helpers
## @exitcode 0 If exactly one virtual environment is found and activated successfully.
## @exitcode 1 If no virtual environment is found, multiple environments are found, or activation fails.
## @stdout May print output produced by the virtual environment activation script.
## @stderr Prints an error when no environment or multiple environments are found.
## @example
##   cd ~/projects/my-project
##   venv
## @see python(1)
venv() {
  local candidate candidates=()

  for candidate in .venv venv .env env; do
    if [ -f "$candidate/bin/activate" ]; then
      candidates+=("$candidate")
    fi
  done

  if [ ${#candidates[@]} -eq 0 ]; then
    echo "venv: No virtual environment found." >&2
    return 1
  elif [ ${#candidates[@]} -eq 1 ]; then
    # shellcheck disable=SC1090
    . "${candidates[0]}/bin/activate"
  else
    echo "Multiple virtual environments found:" >&2
    printf '  %s\n' "${candidates[@]}" >&2
    return 1
  fi
}


# Help — all-inclusive manual for every loaded dotfiles alias/function.
# Sourced from common/ (see source-common.tmpl). Scans ~/.dotfiles tree.

MANUAL_LAST_COUNT=0

# Collect every shell module file that may define aliases/functions.
_manual_files() {
  local shell_dir="${DF_DIR:-$HOME/.dotfiles}"
  local -a files=()
  local seen="|"
  local f role

  _manual_add() {
    local path="$1"
    [ -f "$path" ] || return 0
    case "$seen" in *"|${path}|"*) return 0 ;; esac
    seen="${seen}${path}|"
    files+=("$path")
  }

  # common (skip non-command config files)
  for f in aliases functions help; do
    _manual_add "${shell_dir}/common/${f}"
  done

  # role extras currently applied
  role="${DOTFILES_ROLE:-}"
  if [ -n "$role" ] && [ -d "${shell_dir}/${role}" ]; then
    for f in "${shell_dir}/${role}"/*; do
      [ -f "$f" ] || continue
      case "$(basename "$f")" in
        env|README|README.md) continue ;;
      esac
      _manual_add "$f"
    done
  fi

  # optional modules (docker, …) — whatever is present under modules/
  if [ -d "${shell_dir}/modules" ]; then
    for f in "${shell_dir}/modules"/*/*; do
      [ -f "$f" ] || continue
      case "$(basename "$f")" in
        *.md|*.txt|*.toml|*.yaml|*.yml|README) continue ;;
      esac
      _manual_add "$f"
    done
  fi

  # user-managed aliases file if present
  _manual_add "${HOME}/.bash_aliases"

  printf '%s\n' "${files[@]}"
}

_manual_init_colors() {
  if [ -t 1 ]; then
    MANUAL_TITLE=$'\033[1;35m'
    MANUAL_NAME=$'\033[1;33m'
    MANUAL_ARROW=$'\033[2;37m'
    MANUAL_DIM=$'\033[2m'
    MANUAL_RESET=$'\033[0m'
  else
    MANUAL_TITLE="" MANUAL_NAME="" MANUAL_ARROW="" MANUAL_DIM="" MANUAL_RESET=""
  fi
}

_manual_is_internal() {
  local block="$1"
  grep -q '@internal' <<<"$block"
}

_manual_summary() {
  local block="$1"
  local line desc=""
  while IFS= read -r line; do
    # Trim leading whitespace, then optional comment markers.
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line#\# }"
    line="${line#\#}"
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "$line" =~ ^[[:space:]]*$ ]] && continue
    [[ "$line" == @internal* ]] && continue
    [[ "$line" =~ ^(Usage|Examples?|Example|Requires): ]] && continue
    [[ "$line" == MANUAL_ALL* ]] && continue
    [[ "$line" =~ ^─+$ ]] && continue
    [[ "$line" =~ ^──.*── ]] && continue
    [[ "$line" =~ ─{3,} ]] && continue
    desc="$line"
  done <<<"$block"
  [ -n "$desc" ] && printf '%s' "$desc"
  [ -n "$desc" ]
}

_manual_scan_file() {
  local file="$1"
  local pattern="${2:-}"
  local mode="${3:-all}"
  local show_internal="${MANUAL_ALL:-0}"

  local rel="${file#${HOME}/.dotfiles/}"
  rel="${rel#${HOME}/}"
  [ "$rel" = "$file" ] && rel="${file##*/}"

  local comment_block="" file_header_shown=0 count=0
  local line nm body desc internal

  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" =~ ^#[[:space:]]*──[[:space:]]*(.+)[[:space:]]──[[:space:]]*$ ]]; then
      rel="${BASH_REMATCH[1]}"
      comment_block=""
      file_header_shown=0
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*# ]]; then
      comment_block+="${line}"$'\n'
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*alias[[:space:]]+([^=[:space:]]+)=(.*)$ ]]; then
      [ "$mode" = "functions" ] && { comment_block=""; continue; }
      nm="${BASH_REMATCH[1]}"
      body="${BASH_REMATCH[2]}"
      body="${body#[\"\']}"; body="${body%[\"\']}"
      internal=0
      _manual_is_internal "$comment_block" && internal=1
      desc="$(_manual_summary "$comment_block" 2>/dev/null || true)"
      comment_block=""
      if [ "$internal" -eq 1 ] && [ "$show_internal" != "1" ]; then continue; fi
      if [ -n "$pattern" ] && ! grep -qi -- "$pattern" <<<"$nm $body $desc"; then continue; fi
      if [ "$file_header_shown" -eq 0 ]; then
        printf "\n${MANUAL_TITLE}══ %s ══${MANUAL_RESET}\n" "$rel"
        file_header_shown=1
      fi
      if [ -n "$desc" ]; then
        printf "  ${MANUAL_NAME}%-22s${MANUAL_RESET} %s\n" "$nm" "$desc"
        printf "  ${MANUAL_DIM}%-22s  → %s${MANUAL_RESET}\n" "" "$body"
      else
        printf "  ${MANUAL_NAME}%-22s${MANUAL_ARROW} → ${MANUAL_RESET}%s\n" "$nm" "$body"
      fi
      ((count++)) || true
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*function[[:space:]]+([a-zA-Z_][a-zA-Z0-9_]*) ]] \
       || [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*\(\)[[:space:]]*\{? ]]; then
      [ "$mode" = "aliases" ] && { comment_block=""; continue; }
      nm="${BASH_REMATCH[1]}"
      [[ "$nm" =~ ^_ ]] && [ "$show_internal" != "1" ] && { comment_block=""; continue; }
      internal=0
      _manual_is_internal "$comment_block" && internal=1
      desc="$(_manual_summary "$comment_block" 2>/dev/null || true)"
      comment_block=""
      if [ "$internal" -eq 1 ] && [ "$show_internal" != "1" ]; then continue; fi
      if [ -n "$pattern" ] && ! grep -qi -- "$pattern" <<<"$nm $desc"; then continue; fi
      if [ "$file_header_shown" -eq 0 ]; then
        printf "\n${MANUAL_TITLE}══ %s ══${MANUAL_RESET}\n" "$rel"
        file_header_shown=1
      fi
      if [ -n "$desc" ]; then
        printf "  ${MANUAL_NAME}%-22s${MANUAL_RESET} %s\n" "${nm}()" "$desc"
      else
        printf "  ${MANUAL_NAME}%-22s${MANUAL_RESET}\n" "${nm}()"
      fi
      ((count++)) || true
      continue
    fi

    [[ -z "${line//[[:space:]]/}" ]] || comment_block=""
  done < "$file"

  MANUAL_LAST_COUNT=$count
}

# Show every loaded alias and function across common, role, and modules.
# Usage: manual [pattern]
#        MANUAL_ALL=1 manual
manual() {
  local pattern="${1:-}"
  local file total=0

  if [ -z "${BASH_VERSION:-}" ]; then
    echo "manual: currently requires bash (open a bash shell or run: bash -ic manual)" >&2
    return 2
  fi

  _manual_init_colors

  printf "${MANUAL_TITLE}Dotfiles manual${MANUAL_RESET}"
  if [ -n "${DOTFILES_ROLE:-}" ]; then
    printf "  ${MANUAL_DIM}(role=%s)${MANUAL_RESET}" "$DOTFILES_ROLE"
  fi
  printf "\n"

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    _manual_scan_file "$file" "$pattern" all
    total=$((total + MANUAL_LAST_COUNT))
  done < <(_manual_files)

  if [ -n "$pattern" ] && [ "$total" -eq 0 ]; then
    echo "manual: no matches for: $pattern" >&2
    return 1
  fi
  printf "\n${MANUAL_DIM}%d entr(ies)${MANUAL_RESET}\n" "$total"
}

# List aliases only (all modules).
# Usage: aliases [pattern]
aliases() {
  local pattern="${1:-}"
  local file total=0

  if [ -z "${BASH_VERSION:-}" ]; then
    echo "aliases: currently requires bash (open a bash shell or run: bash -ic aliases)" >&2
    return 2
  fi

  _manual_init_colors

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    _manual_scan_file "$file" "$pattern" aliases
    total=$((total + MANUAL_LAST_COUNT))
  done < <(_manual_files)

  if [ -n "$pattern" ] && [ "$total" -eq 0 ]; then
    echo "aliases: no matches for: $pattern" >&2
    return 1
  fi
  printf "\n${MANUAL_DIM}%d alias(es)${MANUAL_RESET}\n" "$total"
}

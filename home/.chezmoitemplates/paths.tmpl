{{- /* Manage PATH via chezmoidata/paths.toml.
       prepend — prepended to PATH (highest priority)
       common/local/remote — appended to PATH (lowest priority)
       Expected context: root data dict (.role, .modules, .paths).
*/ -}}
{{- $paths := dig "paths" (dict) . -}}

{{- /* Prepend entries (highest priority) */ -}}
{{- $prefix := "" -}}
{{- range $i, $d := dig "prepend" (list) $paths -}}
{{-   if eq $i 0 -}}
{{-     $prefix = $d -}}
{{-   else -}}
{{-     $prefix = printf "%s:%s" $prefix $d -}}
{{-   end -}}
{{- end -}}
{{- if $prefix -}}
{{- printf "\n\n" -}}
# Prepended PATH entries (chezmoidata/paths.toml) — highest priority.
export PATH="{{ $prefix }}:$PATH"
{{- end -}}

{{- /* Append entries (lowest priority) */ -}}
{{- $suffix := "" -}}
{{- range $d := dig "common" (list) $paths -}}
{{-   $suffix = printf "%s:%s" $suffix $d -}}
{{- end -}}
{{- if eq .role "local" -}}
{{-   range $d := dig "local" (list) $paths -}}
{{-     $suffix = printf "%s:%s" $suffix $d -}}
{{-   end -}}
{{- end -}}
{{- if eq .role "remote" -}}
{{-   range $d := dig "remote" (list) $paths -}}
{{-     $suffix = printf "%s:%s" $suffix $d -}}
{{-   end -}}
{{- end -}}
{{- if $suffix -}}
{{- printf "\n\n" -}}
# Appended PATH entries (chezmoidata/paths.toml) — lowest priority.
export PATH="$PATH{{ $suffix }}"
{{- end -}}

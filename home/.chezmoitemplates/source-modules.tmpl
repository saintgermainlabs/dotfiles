{{- /* Optional modules under ~/.dotfiles/modules/<name>/.
     Prefer module.sh (loads functions + interactive aliases). Else functions.sh,
     aliases.sh, or legacy functions (docker). install.sh/README/config not sourced. */ -}}
{{- $skip := list "common" "git" "ssh" "gui" "nautilus" "nautilus_extensions" "thunar" "mise" -}}
{{- range $name, $on := .modules }}
{{- if and $on (not (has $name $skip)) }}
# module: {{ $name }}
_df_mod="${DF_DIR}/modules/{{ $name }}"
if [ -r "${_df_mod}/module.sh" ]; then
  . "${_df_mod}/module.sh"
else
  [ -r "${_df_mod}/functions.sh" ] && . "${_df_mod}/functions.sh"
  [ -r "${_df_mod}/aliases.sh" ] && . "${_df_mod}/aliases.sh"
  [ -r "${_df_mod}/functions" ] && . "${_df_mod}/functions"
fi
{{- end }}
{{- end }}

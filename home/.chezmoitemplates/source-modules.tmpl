{{- /* Optional modules under ~/.dotfiles/modules/<name>/.
     _df_load_module (common/helpers.sh) reads <name>/config.toml [bootstrap]
     (env -> files -> interactive -> bash|zsh). Without config.toml: module.sh,
     else functions.sh, aliases.sh, functions, local_to_remote.sh.

     local_to_remote and hermes-v2 are only sourced when .role == "local".
*/ -}}

{{- $skip := list "common" "git" "ssh" "gui" "nautilus" "nautilus_extensions" "thunar" "mise" -}}
{{- $localOnly := list "local_to_remote" "hermes-v2" -}}

{{- range $name, $on := .modules }}
{{- if and $on (not (has $name $skip)) }}

{{- /* Skip laptop-only modules unless this machine has role=local */ -}}
{{- if or (not (has $name $localOnly)) (eq $.role "local") }}

# module: {{ $name }}
_df_load_module "${DF_DIR}/modules/{{ $name }}"

{{- end }}
{{- end }}
{{- end }}
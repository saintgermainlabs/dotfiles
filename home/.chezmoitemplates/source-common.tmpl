{{- /* Debug helper: DEBUG_MODE=1 bash -i (or zsh -i) prints every file sourced, to stderr. */ -}}
# Loader helpers (_df_source, _df_load_module) — always first, even with modules.common off.
if [ -r "${DF_DIR}/common/helpers.sh" ]; then
  . "${DF_DIR}/common/helpers.sh"
  [ -n "${DEBUG_MODE:-}" ] && printf 'dotfiles: sourcing %s\n' "${DF_DIR}/common/helpers.sh" >&2
else
  # Minimal fallback so the rc never breaks if helpers.sh is missing.
  _df_source() { [ -r "$1" ] || return 0; [ -n "${DEBUG_MODE:-}" ] && printf 'dotfiles: sourcing %s\n' "$1" >&2; . "$1"; }
  _df_load_module() { _df_source "$1/module.sh"; }
fi

{{- /* Source common files in fixed order (init is sourced later by the rc). */ -}}
{{- if .modules.common }}
# common: shell -> aliases -> functions -> prompt -> help -> completions (init comes after modules)
for _df in shell aliases functions prompt help completions.bash completions.zsh; do
  _df_source "${DF_DIR}/common/${_df}"
done
unset _df
# utils: every file in common/utils (chezmoi helpers such as chezmoi_add_env)
for _df in "${DF_DIR}"/common/utils/*; do
  _df_source "${_df}"
done
unset _df
{{- end }}

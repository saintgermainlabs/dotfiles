# ~/.zshrc: executed by zsh for interactive shells.

DF_DIR="${HOME}/.dotfiles"

# Root of the chezmoi source state (the repo's home/ dir). Asked from chezmoi so
# it follows the repo wherever it is installed; falls back to the default location.
CHEZMOI_HOME="$(realpath "$(chezmoi source-path 2>/dev/null)" 2>/dev/null)" || CHEZMOI_HOME=""
[ -n "${CHEZMOI_HOME}" ] || CHEZMOI_HOME="${HOME}/.local/share/chezmoi/home"
export CHEZMOI_HOME
# CHEZMOI_CLONE_DIR: root of the cloned dotfiles repo (parent of the .chezmoiroot "home" dir).
CHEZMOI_CLONE_DIR="$(git -C "${CHEZMOI_HOME}" rev-parse --show-toplevel 2>/dev/null)" || CHEZMOI_CLONE_DIR=""
[ -n "${CHEZMOI_CLONE_DIR}" ] || CHEZMOI_CLONE_DIR="$(dirname "${CHEZMOI_HOME}")"
export CHEZMOI_CLONE_DIR

{{ template "source-common.tmpl" . }}

# Role extras
{{ template "source-role.tmpl" . }}

# Optional modules (docker, etc.)
{{ template "source-modules.tmpl" . }}

# PATH entries first, then late init (mise, zoxide, fzf, starship) so mise
# activation re-prepends its pinned tools ahead of the paths.toml /usr/bin prepend.
{{- if .modules.common }}
{{- template "paths.tmpl" . }}
_df_source "${DF_DIR}/common/init"
{{- end }}

# Machine-local, untracked overrides.
_df_source ~/.zshrc.local

# Colored Alacritty windows for ssh and AI agents
_df_source ~/.config/alacritty/terminal-roles.sh
